# Identifiants Météo-France pour la fonction serverless api/vigilance.js.
# À créer gratuitement sur https://portail-api.meteofrance.fr (compte +
# application "Vigilance" / DPVigilance), puis à définir comme variables
# d'environnement dans le dashboard Vercel (Settings → Environment Variables)
# — ne jamais les committer dans le dépôt.

METEOFRANCE_CLIENT_ID=
METEOFRANCE_CLIENT_SECRET=
